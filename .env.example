# GrowthWave Digital Environment Configuration

# Optional: Webhook URL to receive lead enquiry submissions in production
# Examples: Zapier webhook, Make.com webhook, Slack incoming webhook, or custom CRM endpoint
# If left empty, submissions run in demo mode (logged to server console with a transparent notice)
ENQUIRY_WEBHOOK_URL=

# Optional: Production site URL for canonical metadata and sitemaps
NEXT_PUBLIC_SITE_URL=https://growthwave-digital.example.com
